{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "outfit-matcher-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd app && flutter run -d web-server --web-port 5858"],
      "port": 5858
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd mobile && npx expo start --web --port 8088"],
      "port": 8088
    }
  ]
}
