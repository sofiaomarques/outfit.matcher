# Servidor estático do site (build do `expo export --platform web`).
# A imagem oficial do nginx passa este arquivo por envsubst na subida, então
# ${PORT} vira a porta que o Cloud Run manda (8080 por padrão).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml image/x-icon font/ttf font/otf;
    gzip_min_length 1024;

    # add_header dentro de um location descarta os do nível server, então os
    # cabeçalhos de segurança ficam num arquivo só, incluído em cada location.
    include /etc/nginx/snippets/security-headers.conf;

    # Arquivos com hash no nome (JS, fontes, imagens): cache longo.
    location /_expo/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Verificação de saúde (sem passar pelo fallback do app).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # O app é uma página só: qualquer outra rota cai no index.html, que não
    # pode ficar em cache (aponta pros arquivos novos a cada deploy).
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
